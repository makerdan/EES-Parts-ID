# =============================================================================
# Parts ID — Required Secrets
# Set these in the Replit Secrets pane (not in a committed .env file).
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication
# Obtain these from your Clerk dashboard → API Keys:
#   https://dashboard.clerk.com
#
# To enable MFA: Clerk dashboard → User & Authentication → Multi-factor auth
# -----------------------------------------------------------------------------

# Publishable key for the Expo mobile app (must start with pk_live_ or pk_test_).
# Used by ClerkProvider in the mobile app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Publishable key for the API server (same value as above).
# Used by clerkMiddleware in app.ts to resolve the active Clerk instance.
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key for the API server (must start with sk_live_ or sk_test_).
# Used by @clerk/express to verify session tokens and call the Clerk Backend API.
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override for the Clerk Frontend API base URL (integration tests only).
# Leave blank or unset in all real deployments — the middleware defaults to
# https://frontend-api.clerk.dev.  Only set this in test environments where you
# need to redirect the Clerk proxy at a local fake upstream.
# Accepted values: any valid HTTP/HTTPS base URL, or empty/unset.
# Default: (not set — real Clerk FAPI is used)
CLERK_FAPI_URL=

# Clerk user ID of the admin account for this deployment.
# HOW TO SET: Leave blank initially. Deploy the app, sign in with the account
# that should have admin access, then copy that user's ID from:
#   Clerk dashboard → Users → <your account> → User ID (format: user_…)
# Set this secret and redeploy. The user will be force-approved on every request.
ADMIN_CLERK_USER_ID=user_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opt-out flag to disable admin MFA enforcement (not recommended).
# Admin MFA is enforced by default. Any admin session that lacks a completed
# second factor (TOTP, phone code, or hardware key) in the Clerk amr session
# claim is rejected with 403 { code: "MFA_REQUIRED" }.
# Set to "true" only in development or when all admins are mid-enrollment.
# The server emits a startup warning when this flag is set.
# Accepted values: "true" | unset (any other value also enforces MFA)
# Default: unset (MFA enforced)
SKIP_ADMIN_MFA=

# Clerk Frontend API proxy path (optional, production only).
# Set this to your deployed API server's Clerk proxy URL so that Clerk
# Frontend API traffic routes through your own domain:
#   e.g. https://your-app.replit.app/api/__clerk
# Leave unset in development — the proxy is skipped outside of production.
EXPO_PUBLIC_CLERK_PROXY_URL=

# -----------------------------------------------------------------------------
# Admin Panel
# -----------------------------------------------------------------------------

# Server-held secret used to domain-separate and rotate privacy-safe screen-view
# visitor grouping. It is never sent to clients or stored in telemetry.
# Accepted values: a long random secret string; use the existing SESSION_SECRET
# when available. Optional — unique-visitor reporting is disabled if unset.
SESSION_SECRET=

# Password used to generate short-lived HMAC tokens for the admin panel.
# Choose a long random string (e.g. openssl rand -hex 32).
ADMIN_PASSWORD=

# Maximum number of rows the admin SQL query endpoint will return per request.
# Accepted values: any positive integer.
# Default: 500. Raise only if you need larger result sets for exports.
ADMIN_QUERY_MAX_ROWS=500

# Regex pattern (RE2-compatible) matched against column names to redact
# sensitive values before they are returned by the admin SQL query endpoint.
# Accepted values: a valid JavaScript regex string, e.g. password|secret|token
# Default: unset (uses the built-in default blocklist defined in adminQuery.ts).
ADMIN_QUERY_SENSITIVE_COLUMNS=

# Maximum wall-clock time in milliseconds allowed for a single admin SQL query.
# Accepted values: any positive integer (milliseconds).
# Default: 5000 (5 seconds). Increase for complex analytical queries.
ADMIN_QUERY_TIMEOUT_MS=5000

# How many days of audit log rows to retain before the background pruning job
# removes them. Rows older than this threshold are deleted on a daily schedule.
# Accepted values: any positive integer (days).
# Default: 90
AUDIT_LOG_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string (provided automatically by Replit Postgres).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# -----------------------------------------------------------------------------
# AI Provider
# -----------------------------------------------------------------------------

# Which AI backend to use for part identification, translation, and enrichment.
# Accepted values: "poe" | "openai"
# Default: "poe". Switch to "openai" to use the Replit OpenAI integration.
AI_PROVIDER=poe

# Poe API key — required when AI_PROVIDER=poe.
# Obtain from https://poe.com/api_key (your personal Poe API key).
# Must be set when AI_PROVIDER=poe; ignored otherwise.
POE_API_KEY2=

# OpenAI-compatible base URL — required when AI_PROVIDER=openai.
# Provided automatically by the Replit OpenAI integration (AI_INTEGRATIONS_OPENAI_BASE_URL).
# Do not set manually unless you are pointing at a custom OpenAI-compatible endpoint.
AI_INTEGRATIONS_OPENAI_BASE_URL=

# OpenAI API key — required when AI_PROVIDER=openai.
# Provided automatically by the Replit OpenAI integration (AI_INTEGRATIONS_OPENAI_API_KEY).
# Do not set manually unless you are using a bring-your-own-key setup.
AI_INTEGRATIONS_OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Object Storage
# (Provided automatically by the Replit Object Storage integration.)
# -----------------------------------------------------------------------------

# Replit Object Storage bucket ID used for uploaded part images and attachments.
# Accepted values: a valid Replit bucket ID (format: replit-objstore-…).
# Required — the server throws on startup if unset and object storage is accessed.
# Set automatically when you provision Object Storage in the Replit workspace.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# Subdirectory prefix used for privately stored objects within the bucket.
# Accepted values: any filesystem-safe string without leading slashes.
# Default: "uploads". Change only if you need to isolate objects from a prior dataset.
PRIVATE_OBJECT_DIR=uploads

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# TCP port the API server binds to.
# Accepted values: any valid port number (1–65535).
# Provided automatically by Replit — do not set manually in production.
# Default in development: 3000 (or whatever Replit assigns via PORT).
PORT=3000

# Pino log level for the API server.
# Accepted values: "fatal" | "error" | "warn" | "info" | "debug" | "trace"
# Default: "info". Use "debug" locally for verbose output; keep "info" or
# "warn" in production to avoid log volume costs.
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins for the API server.
# Accepted values: e.g. https://your-app.replit.app,https://staging.example.com
# Required in production — the server denies all cross-origin requests if unset.
# Leave unset in development (all origins are allowed in non-production mode).
CORS_ALLOWED_ORIGINS=

# Database round-trip latency threshold in milliseconds above which the /health
# endpoint reports status "degraded" instead of "ok".
# Accepted values: any positive integer (milliseconds).
# Default: 500. Lower this to get earlier degraded alerts; raise it on high-latency links.
DB_LATENCY_DEGRADED_MS=500

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------

# Delay in milliseconds between retry attempts when a Poe bot chain call fails.
# Accepted values: any non-negative integer (milliseconds).
# Default: 500. Increase to back off harder under API throttling.
POE_CHAIN_RETRY_DELAY_MS=500

# Maximum part-identification requests per minute per IP address.
# Accepted values: any positive integer.
# Default: 20. Raise on trusted internal networks; lower to protect AI quota.
RATE_LIMIT_IDENTIFY_PER_MIN=20

# Maximum translation requests per minute per IP address.
# Accepted values: any positive integer.
# Default: 60.
RATE_LIMIT_TRANSLATE_PER_MIN=60

# Maximum part-card enrichment requests per minute per IP address.
# Accepted values: any positive integer.
# Default: 30.
RATE_LIMIT_PART_CARD_PER_MIN=30

# Maximum dimension-estimation search requests per sliding window per device ID.
# Accepted values: any positive integer.
# Default: 10.
ESTIMATE_SEARCH_RATE_LIMIT=10

# Maximum dimension-estimation search requests per sliding window per IP address,
# used as a ceiling when many device IDs share the same IP (e.g. behind NAT).
# Accepted values: any positive integer.
# Default: 50.
ESTIMATE_SEARCH_IP_CEILING=50

# Sliding window length in milliseconds for dimension-estimation search rate limiting.
# Accepted values: any positive integer (milliseconds).
# Default: 60000 (1 minute).
ESTIMATE_SEARCH_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Bulk Enrichment Seed Script
# These vars are only read by artifacts/api-server/src/seed/bulk-enrich.ts and
# are not used by the live server. They are only relevant when running the seed
# script manually (e.g. to backfill AI-generated keywords for existing parts).
# -----------------------------------------------------------------------------

# Number of parts processed in each enrichment batch.
# Accepted values: any positive integer.
# Default: 10.
ENRICH_BATCH_SIZE=10

# Number of batches processed concurrently.
# Accepted values: any positive integer.
# Default: 5. Lower this if you hit API rate limits.
ENRICH_CONCURRENCY=5

# Delay in milliseconds between batch submissions.
# Accepted values: any non-negative integer (milliseconds).
# Default: 200. Increase to stay within AI provider rate limits.
ENRICH_DELAY_MS=200

# Maximum retry attempts per part on AI provider errors.
# Accepted values: any non-negative integer.
# Default: 3.
ENRICH_RETRIES=3

# OpenAI model name used for bulk enrichment (only when AI_PROVIDER=openai).
# Accepted values: any valid OpenAI model identifier.
# Default: "gpt-4o-mini".
ENRICH_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# AI Abuse Controls
# -----------------------------------------------------------------------------

# Maximum requests per minute for the /api/reference/ask endpoint (per user).
# Accepted values: any positive integer.
# Default: 20.
RATE_LIMIT_REFERENCE_ASK_PER_MIN=20

# Maximum Help assistant requests per minute per authenticated user.
# Accepted values: any positive integer.
# Default: 20. Lower to protect provider quota; raise only for trusted usage.
RATE_LIMIT_HELP_ASK_PER_MIN=20

# Maximum catalog PDF upload/resume requests per minute (per admin user).
# Accepted values: any positive integer.
# Default: 5.
RATE_LIMIT_CATALOG_PDF_UPLOAD_PER_MIN=5

# Maximum number of catalog PDF background processing jobs allowed to run
# concurrently. Requests that would exceed this cap receive a 429 response.
# Accepted values: any positive integer.
# Default: 3.
MAX_CONCURRENT_PDF_JOBS=3

# Maximum admin SQL query requests per minute per authenticated admin user.
# Accepted values: any positive integer.
# Default: 20.
RATE_LIMIT_ADMIN_QUERY_PER_MIN=20

# Maximum inventory search requests per minute per authenticated user.
# Accepted values: any positive integer.
# Default: 60.
RATE_LIMIT_INVENTORY_SEARCH_PER_MIN=60

# Maximum contact/support form submissions per 10-minute window per IP address.
# Accepted values: any positive integer.
# Default: 5.
RATE_LIMIT_CONTACT_PER_10MIN=5

# Public domain for the deployed mockup-sandbox (internal tools).
# Required for admin tool links to work in production native builds.
# When set, the Zone Editor and Warehouse Map buttons in the mobile admin
# dashboard and the Zone Editor button on the Map tab open the correct URLs.
# When unset, those buttons are hidden rather than shown with a broken link.
# Example: your-workspace.replit.app
EXPO_PUBLIC_DOMAIN=
