# =============================================================================
# Parts ID — Required Secrets
# Set these in the Replit Secrets pane (not in a committed .env file).
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication
# Obtain these from your Clerk dashboard → API Keys:
#   https://dashboard.clerk.com
#
# To enable MFA: Clerk dashboard → User & Authentication → Multi-factor auth
# -----------------------------------------------------------------------------

# Publishable key for the Expo mobile app (must start with pk_live_ or pk_test_).
# Used by ClerkProvider in the mobile app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Publishable key for the API server (same value as above).
# Used by clerkMiddleware in app.ts to resolve the active Clerk instance.
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key for the API server (must start with sk_live_ or sk_test_).
# Used by @clerk/express to verify session tokens and call the Clerk Backend API.
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk user ID of the admin account for this deployment.
# HOW TO SET: Leave blank initially. Deploy the app, sign in with the account
# that should have admin access, then copy that user's ID from:
#   Clerk dashboard → Users → <your account> → User ID (format: user_…)
# Set this secret and redeploy. The user will be force-approved on every request.
ADMIN_CLERK_USER_ID=user_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Frontend API proxy path (optional, production only).
# Set this to your deployed API server's Clerk proxy URL so that Clerk
# Frontend API traffic routes through your own domain:
#   e.g. https://your-app.replit.app/api/__clerk
# Leave unset in development — the proxy is skipped outside of production.
EXPO_PUBLIC_CLERK_PROXY_URL=

# -----------------------------------------------------------------------------
# Admin Panel
# -----------------------------------------------------------------------------

# Password used to generate short-lived HMAC tokens for the admin panel.
# Choose a long random string (e.g. openssl rand -hex 32).
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string (provided automatically by Replit Postgres).
DATABASE_URL=postgresql://user:password@host:5432/dbname
