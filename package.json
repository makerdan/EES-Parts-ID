{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "pretypecheck:libs": "pnpm --filter @workspace/api-spec run codegen:ensure",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run codegen:check && pnpm --filter @workspace/db run schema:check && pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "codegen:check": "pnpm --filter @workspace/api-spec run codegen:check",
    "lint:libs": "eslint lib/ --ext .ts",
    "test": "bash scripts/test-all.sh",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix"
  },
  "private": true,
  "engines": {
    "node": "24.13.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^8.57.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "lodash": ">=4.18.0",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=5.0.6",
      "@babel/core": ">=7.29.6 <8.0.0",
      "esbuild": ">=0.28.1",
      "form-data": ">=4.0.6",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0",
      "js-yaml@<3.15.0": "3.15.0",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "protobufjs@>=7.0.0 <7.6.5": ">=7.6.5 <8.0.0",
      "linkify-it": ">=5.0.1",
      "markdown-it": ">=14.2.0",
      "postcss": ">=8.5.10",
      "protobufjs@>=7.5.0 <7.6.5": ">=7.6.5 <8.0.0",
      "qs": ">=6.15.2",
      "shell-quote": ">=1.8.4",
      "tar": ">=7.5.16",
      "tmp": ">=0.2.6",
      "undici": ">=7.28.0 <8.0.0",
      "uuid": ">=11.1.1",
      "vite": ">=7.3.5",
      "ws": ">=8.21.0",
      "yaml": ">=2.8.3"
    },
    "onlyBuiltDependencies": [
      "@pnpm/exe",
      "@swc/core",
      "canvas",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  }
}
