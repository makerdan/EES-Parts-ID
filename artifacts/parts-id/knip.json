{
  "entry": [
    "app/**/*.{ts,tsx}",
    "server/**/*.ts",
    "scripts/**/*.mjs",
    "modules/**/app.plugin.js",
    "modules/**/plugin/index.js",
    "modules/**/src/index.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "constants/**/*.ts",
    "contexts/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.ts",
    "server/**/*.ts",
    "utils/**/*.{ts,tsx}",
    "modules/**/src/**/*.ts"
  ],
  "ignore": [
    ".expo/**",
    "static-build/**",
    "components/BarcodeEditor.tsx",
    "components/KeywordEditor.tsx",
    "components/CatalogPickerModal.tsx",
    "components/FilterPanel.tsx",
    "components/PartCard.tsx",
    "hooks/useApiStatus.ts",
    "hooks/useMapInteraction.ts",
    "hooks/useWarehouseZones.ts",
    "lib/aisleHierarchy.ts",
    "utils/addToInventory.ts",
    "utils/appAuth.ts",
    "utils/adminSaveUtils.ts",
    "utils/adminUserActions.ts",
    "utils/binValidation.ts",
    "utils/editItemCache.ts",
    "utils/floorPlanCache.ts",
    "utils/helpApi.ts",
    "utils/helpStorage.ts",
    "utils/searchHelpers.ts",
    "utils/webSvgScene.ts"
  ],
  "ignoreBinaries": ["tsc", "metro"],
  "ignoreDependencies": [
    "buffer",
    "tslib",
    "@expo/cli",
    "@expo/ngrok",
    "@stardazed/streams-text-encoding",
    "@ungap/structured-clone",
    "babel-plugin-react-compiler",
    "expo-glass-effect",
    "expo-image",
    "expo-linear-gradient",
    "expo-location",
    "expo-status-bar",
    "expo-symbols",
    "zod-validation-error",
    "expo-modules-core",
    "metro",
    "expo-updates"
  ],
  "ignoreUnresolved": ["babel-preset-expo"]
}