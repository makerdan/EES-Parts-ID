{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @workspace/api-spec run codegen:ensure",
    "pretypecheck": "pnpm --filter @workspace/api-spec run codegen:ensure",
    "dev": "fuser -k -KILL ${PORT}/tcp 2>/dev/null || true; while fuser ${PORT}/tcp 2>/dev/null >/dev/null 2>&1; do sleep 0.2; done && NODE_ENV=development exec tsx src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo && tsc -p tsconfig.test.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck-test.tsbuildinfo",
    "test": "node ../../scripts/serial-lock.mjs -- node scripts/run-tests.mjs",
    "test:coverage": "node ../../scripts/serial-lock.mjs -- node scripts/run-tests.mjs --coverage",
    "seed": "tsx src/seed/run.ts",
    "seed:reference": "tsx src/seed/runQuickLookupChips.ts",
    "seed:barcodes": "tsx src/seed/import-barcodes.ts",
    "lint": "eslint . --ext .ts && knip",
    "dead-exports": "knip"
  },
  "dependencies": {
    "@clerk/express": "^2.1.35",
    "@clerk/shared": "^4.23.0",
    "@google-cloud/storage": "^7.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/integrations-poe-server": "workspace:*",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5",
    "fuse.js": "^7.1.0",
    "helmet": "^8.2.0",
    "http-proxy-middleware": "^4.1.1",
    "openai": "^6.27.0",
    "pdfjs-dist": "^5.7.284",
    "pino": "^9",
    "pino-http": "^10",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "eslint": "^8.57.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.3.0",
    "knip": "^6.24.0",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "ts-jest": "^29.4.9",
    "tsx": "catalog:"
  }
}
