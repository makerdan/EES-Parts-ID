{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node", "jest"],
    "noEmit": true,
    // Required by clerkProxyReset.integration.runner.ts which uses explicit
    // .ts import paths so that tsx (used to run it outside Jest) can resolve
    // the ESM modules on Node.js v24 where bare imports no longer
    // auto-resolve to .ts.  allowImportingTsExtensions requires noEmit:true
    // (already set above).
    "allowImportingTsExtensions": true
  },
  "include": ["src", "__tests__"],
  // These two test files import parts-id utilities that in turn import
  // React Native / DOM code incompatible with the api-server tsconfig.
  // They are still compiled and run by Jest via ts-jest (isolatedModules:true),
  // which erases import-type references before the RN/TSX chain is followed.
  "exclude": [
    "src/__tests__/editItemCache.test.ts",
    "src/__tests__/adminSaveOps.test.ts"
  ]
}
