modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "lint"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/parts-id run lint && pnpm --filter @workspace/api-server run lint"

[[workflows.workflow]]
name = "codegen:check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-spec run codegen:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/parts-id: expo"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/parts-id"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/parts-id run dev"
cwd = "./artifacts/parts-id"
waitForPort = 22660
ensurePreviewReachable = "/status"
router = "expo-domain"

[workflows.workflow.tasks.env]
PORT = "22660"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "post-merge-health-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "verify-fts"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "spec:check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "spec:check:tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tsc"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint:mocks"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema:check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "canvas-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tsconfig:check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "env:check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "parts-id-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck:libs"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "security-audit"

[[workflows.workflow]]
name = "post-merge-health-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/test-post-merge.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "verify-fts"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run verify-fts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm -w run typecheck:libs && pnpm --filter @workspace/parts-id exec tsc --noEmit"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "spec:check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-spec run spec:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "spec:check:tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-spec test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "tsc"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "lint:mocks"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run lint:mocks"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "schema:check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run schema:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "canvas-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter mockup-sandbox run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "tsconfig:check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run tsconfig:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "env:check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts env:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[[workflows.workflow]]
name = "parts-id-typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/parts-id run typecheck"

[[workflows.workflow]]
name = "typecheck:libs"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'for i in 1 2 3; do pnpm -w run typecheck:libs && exit 0; sleep 2; done; exit 1'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "security-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm audit --audit-level=high"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 420000

[[ports]]
localPort = 3001
externalPort = 4200

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 22660
externalPort = 3000

[[ports]]
localPort = 22661
externalPort = 3002

[userenv]

[userenv.shared]
ADMIN_CLERK_USER_ID = "user_3G1GaTHFmaxu9rUzvKJqaNIk0nv"

[userenv.production]
CORS_ALLOWED_ORIGINS = "https://eespartsid.replit.app"

[nix]
channel = "stable-25_05"
