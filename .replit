modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["bash", "artifacts/parts-id/scripts/build-prod.sh"]
run = ["bash", "artifacts/parts-id/scripts/start-prod.sh"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/parts-id: expo"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/parts-id"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/parts-id run dev"
cwd = "./artifacts/parts-id"
waitForPort = 19000
ensurePreviewReachable = "/status"
router = "expo-domain"

[workflows.workflow.tasks.env]
PORT = "19000"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 3001

[workflows.workflow.tasks.env]
PORT = "3001"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-fast"
[[workflows.workflow]]
name = "test-fast"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test-fast"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-standard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test-standard"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-standard-plus"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test-standard-plus"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-heavy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test-heavy"

[workflows.workflow.metadata]
isValidation = true
[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 420000

[[ports]]
localPort = 3001
externalPort = 4200

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 22660
externalPort = 3000

[[ports]]
localPort = 22661
externalPort = 3002

[userenv]

[userenv.shared]
ADMIN_CLERK_USER_ID = "user_3G1GaTHFmaxu9rUzvKJqaNIk0nv"
SKIP_ADMIN_MFA = "true"

[userenv.production]
CORS_ALLOWED_ORIGINS = "https://eespartsid.replit.app"
REPLIT_INTERNAL_APP_DOMAIN = "eespartsid.replit.app"

[nix]
channel = "stable-25_05"
